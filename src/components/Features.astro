---
import { defaultLang, type SupportedLocale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLocale;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const features = [
  {
    title: t('features.f1.title'),
    desc: t('features.f1.desc'),
    badge: 'AES-256-GCM',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    title: t('features.f2.title'),
    desc: t('features.f2.desc'),
    badge: '100% Local',
    icon: `<rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 8 6 4-6 4Z"/>`,
  },
  {
    title: t('features.f3.title'),
    desc: t('features.f3.desc'),
    badge: 'Any Format',
    icon: `<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/>`,
  },
  {
    title: t('features.f4.title'),
    desc: t('features.f4.desc'),
    badge: 'Offline-Ready',
    icon: `<path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>`,
  },
];
---

<section id="features" class="py-16 sm:py-24 border-t border-brand-sand/70 dark:border-brand-teal/20 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-brand-dark dark:text-white">
        {t('features.title')}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-brand-textMutedLight dark:text-brand-textMutedDark">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        features.map((feat) => (
          <div class="relative group p-7 rounded-2xl bg-white dark:bg-brand-surfaceDark border border-brand-sand/90 dark:border-brand-teal/30 shadow-sm hover:shadow-md transition-all duration-200">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-brand-sand/40 dark:bg-brand-surfaceDark2 border border-brand-sand dark:border-brand-teal/40 flex items-center justify-center text-brand-dark dark:text-brand-gold group-hover:scale-105 transition-transform">
                <svg
                  class="w-6 h-6"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={feat.icon}
                />
              </div>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-sand/50 dark:bg-brand-teal/20 text-brand-dark dark:text-brand-gold border border-brand-sand/80 dark:border-brand-teal/40">
                {feat.badge}
              </span>
            </div>
            <h3 class="text-xl font-bold text-brand-dark dark:text-white mb-2">
              {feat.title}
            </h3>
            <p class="text-sm sm:text-base leading-relaxed text-brand-textMutedLight dark:text-brand-textMutedDark">
              {feat.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
