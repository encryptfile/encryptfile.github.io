---
import { defaultLang, type SupportedLocale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLocale;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<button
  id="theme-toggle"
  type="button"
  class="relative inline-flex items-center justify-center w-9 h-9 rounded-xl text-brand-dark/80 dark:text-brand-textDark/80 hover:text-brand-dark dark:hover:text-white hover:bg-brand-sand/40 dark:hover:bg-brand-surfaceDark2 border border-brand-sand/80 dark:border-brand-teal/30 transition-all focus:outline-none focus:ring-2 focus:ring-brand-teal/50"
  aria-label={t('nav.themeToggle')}
  title={t('nav.themeToggle')}
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg
    id="theme-toggle-sun"
    class="w-4 h-4 hidden dark:block text-brand-gold animate-in fade-in duration-200"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon Icon (shown in light mode) -->
  <svg
    id="theme-toggle-moon"
    class="w-4 h-4 block dark:hidden text-brand-dark animate-in fade-in duration-200"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  const toggleBtn = document.getElementById('theme-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  }
</script>
